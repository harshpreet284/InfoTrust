# Django Core
SECRET_KEY=your_secret_key_here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Database
DATABASE_URL=postgres://user:password@localhost:5432/infotrust

# Security & Authentication
JWT_SECRET=your_jwt_secret_here
ACCESS_TOKEN_LIFETIME=300
REFRESH_TOKEN_LIFETIME=86400
# AI Model Configuration
MODEL_ARTIFACT_PATH=./model_artifacts/
MODEL_VERSION=v1

# External APIs
FACT_CHECK_API_KEY=your_api_key_here

# Rate Limiting & Proxy Configuration
NINJA_NUM_PROXIES=0
TRUSTED_PROXIES=
CACHE_BACKEND=django.core.cache.backends.locmem.LocMemCache
CACHE_LOCATION=infotrust_cache
RATE_LIMIT_LOGIN=10/min
RATE_LIMIT_REGISTER=5/min
RATE_LIMIT_CLAIM_SUBMIT=30/hour
RATE_LIMIT_ANALYSIS_STATUS=120/hour
RATE_LIMIT_FAIL_CLOSED=False

# For multi-worker production with PostgreSQL DatabaseCache:
# CACHE_BACKEND=django.core.cache.backends.db.DatabaseCache
# CACHE_LOCATION=infotrust_cache_table
# (Run: python manage.py createcachetable)
